# ── KLServisRumah.my environment variables ─────────────────────────────────
# Copy to ".env.local" for local development. In production, set these in the
# Vercel project settings (Environment Variables). NEVER commit real values;
# ".env*" files are git-ignored except this template.

# NOTE: the former ADMIN_PASSWORD variable and the /admin owner dashboard were
# removed on 2026-08-27 by owner decision (the internal calculators admin page
# is no longer needed). Do not reintroduce an admin surface or its password.

# Shared secret protecting the IndexNow ping endpoint (/api/indexnow).
# Callers pass it as ?secret=... or an Authorization: Bearer header.
# Without it the endpoint fails closed (503).
INDEXNOW_SECRET=replace-with-a-long-random-token

# Shared secret protecting the performance cron endpoint
# (/api/cron/perf-check). Without it the endpoint fails closed (503).
CRON_SECRET=replace-with-a-long-random-token

# Google PageSpeed Insights API key used by /api/cron/perf-check.
PAGESPEED_API_KEY=

# Google Analytics 4 measurement ID (public, client-side by design).
# The analytics script is not loaded until the visitor accepts optional
# analytics in the site's consent banner. Lead events include whatsapp_click,
# phone_call, email_click, form_submit and the estimator/finder events.
NEXT_PUBLIC_GA_ID=
