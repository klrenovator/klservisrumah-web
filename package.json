{
  "name": "klservisrumah-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "seo:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/seo-audit.ts",
    "gen:rates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/generate-rate-book.ts",
    "gen:ai-context": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/generate-ai-context.ts",
    "gen:service-summary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/generate-service-summary.ts",
    "prebuild": "npm run gen:rates && npm run gen:ai-context && npm run gen:service-summary && npm run test:estimators",
    "predev": "npm run gen:rates && npm run gen:ai-context && npm run gen:service-summary",
    "test:estimators": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/test-estimators.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "minimatch": "10.2.6"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
