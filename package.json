{
  "name": "klservisrumah-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "seo:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/seo-audit.ts",
    "audit:html": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/html-quality-audit.ts",
    "audit:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/i18n-parity.ts",
    "audit:meta": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/metadata-schema-audit.ts",
    "audit:seo-inventory": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/seo-metadata-inventory.ts",
    "audit:seo-head": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/seo-head-audit.ts",
    "audit:topical-map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/validate-topical-map.ts",
    "audit:specialty-locale": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/validate-specialty-locale.ts",
    "audit:problem-i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/validate-problem-i18n.ts",
    "audit:location-similarity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/location-similarity-audit.ts",
    "gen:rates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/generate-rate-book.ts",
    "gen:ai-context": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/generate-ai-context.ts",
    "gen:service-summary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/generate-service-summary.ts",
    "gen:blog-index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/generate-blog-index.ts",
    "gen:bp1-map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/generate-bp1-map.ts",
    "audit:bp1": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/bp1-consolidation-audit.ts",
    "audit:schema-size": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/schema-size-audit.ts",
    "validate:blogs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/validate-blog-production.ts",
    "prebuild": "npm run gen:rates && npm run gen:ai-context && npm run gen:service-summary && npm run gen:blog-index && npm run gen:bp1-map && npm run validate:blogs && npm run audit:bp1 -- --source-only && npm run audit:topical-map && npm run audit:specialty-locale && npm run audit:specialty-coverage && npm run audit:service-i18n && npm run audit:i18n && npm run audit:problem-i18n && npm run audit:client-bundle && npm run test:estimators",
    "predev": "npm run gen:rates && npm run gen:ai-context && npm run gen:service-summary && npm run gen:blog-index && npm run gen:bp1-map",
    "test:estimators": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/test-estimators.ts",
    "audit:client-bundle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/client-bundle-guard.ts",
    "audit:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/internal-link-audit.ts",
    "audit:specialty-coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/validate-specialty-coverage.ts",
    "audit:service-i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-resolver.mjs scripts/validate-service-i18n.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "minimatch": "10.2.6"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
